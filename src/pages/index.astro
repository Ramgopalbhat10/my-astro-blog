---
import { getCollection, render } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ProjectEntry from "@components/ProjectEntry.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const work = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

const allprojects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const projects = await Promise.all(
  allprojects.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h1 class="animate font-semibold text-black dark:text-white">
      Hi, I'm Ram Gopal.
    </h1>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate not-prose font-sans font-semibold text-black dark:text-white">
            Tech Lead, Applied AI &amp; Enterprise Search
          </p>
          <p class="animate">
            I'm a hands-on Tech Lead at Carelon Global Solutions in Bengaluru, building enterprise search and internal AI agent platforms.
          </p>
          <p class="animate">
            My work spans indexing pipelines, hybrid retrieval, and retrieval-augmented generation (RAG), alongside agent platforms that support day-to-day engineering. I use evaluations to guide technical decisions and mentor engineers in adopting AI development tools.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Work experience
          </h2>
          <Link href="/work">
            See all work
          </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li>
              <div class="text-sm text-neutral-600 dark:text-neutral-400">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <h3 class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </h3>
              <div class="text-sm text-neutral-600 dark:text-neutral-400">
                {entry.data.role}
              </div>
              <article>
                <p>{entry.data.summary}</p>
              </article>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Recent projects
          </h2>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {projects.map(project => (
            <li>
              <ProjectEntry
                title={project.data.title}
                date={project.data.date}
                demoURL={project.data.demoURL}
                repoURL={project.data.repoURL}
              >
                <project.Content />
              </ProjectEntry>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-black dark:text-white">
          Let's connect
        </h2>
        <article>
          <p>
            For conversations about enterprise search, applied AI, or developer tooling,
            connect with me on LinkedIn or send me an email.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="min-w-0 break-all">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
